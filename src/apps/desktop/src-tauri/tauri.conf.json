{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "AI Modeler",
  "version": "0.1.0",
  "identifier": "com.aimodeler.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build && node ..\\..\\legacy\\scripts\\build_desktop_resources.mjs"
  },
  "app": {
    "windows": [
      {
        "title": "AI Modeler",
        "width": 1600,
        "height": 980,
        "minWidth": 1180,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "resources": {
      "target/package-resources/app/": "app/",
      "target/package-resources/python/": "python/",
      "target/package-resources/bootstrap/": "bootstrap/",
      "target/package-resources/occt-runtime/": "occt-runtime/",
      "target/package-resources/RUNTIME-INFORMATION.txt": "RUNTIME-INFORMATION.txt"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false
    },
    "wix": {
      "language": {
        "zh-CN": {
          "localePath": "./wix/zh-CN.wxl"
        }
      }
      }
    }
  }
}
