* text=auto eol=lf

# 二进制（避免换行/编码被改）
*.png  binary
*.jpg  binary
*.docx binary
*.npz  binary
*.stp  binary
*.CATPart binary
*.xlsx binary

# 中文文本按 UTF-8 处理（Windows 上有些编辑器会猜成 GBK）
*.py   text working-tree-encoding=UTF-8
*.md   text working-tree-encoding=UTF-8
*.json text working-tree-encoding=UTF-8
*.vbs  text eol=crlf
*.txt  text working-tree-encoding=UTF-8

# 让 GitHub 把 .CATScript 认成 VBScript，语法高亮更好看
*.CATScript linguist-language=VBScript
*.vbs.txt   linguist-language=VBScript
